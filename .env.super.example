# Required: create an NGC API key with NGC Catalog access, then paste it here.
NGC_API_KEY=paste_your_ngc_api_key_here

# Pinned NVIDIA Nemotron 3 Super NIM amd64 image verified from NGC.
# This digest is the amd64 image behind tag 2.0.5.
IMAGE=nvcr.io/nim/nvidia/nemotron-3-super-120b-a12b@sha256:e24028cbc5bf3b3c1755ad37f898a0cd954845ab8c7012eb490aed4ac55b44ea

# 2x H100-80GB/NVL target: FP8 tensor-parallel 2 profile.
# Description from list-model-profiles: vllm-fp8-tp2-pp1-65.0
NIM_MODEL_PROFILE=57d42cc7d33914933427e7f8d8cb1773bc11e5c96826c92095820a8776e6a4f6
NIM_MAX_MODEL_LEN=32768
NIM_KVCACHE_PERCENT=0.9
# Required for opencode/OpenAI tool calls with tool_choice=auto.
NIM_PASSTHROUGH_ARGS="--enable-auto-tool-choice --tool-call-parser qwen3_coder"
# Optional: include NIM's per-request stats.tokens_per_second in API responses.
NIM_PER_REQ_METRICS_ENABLE=1

# Optional deployment knobs.
CONTAINER_NAME=nemotron3-super-nim
HOST_PORT=8000
LOCAL_NIM_CACHE=/data/nim-cache/nemotron-3-super-120b-a12b
SHM_SIZE=32g
DOCKER_PLATFORM=linux/amd64

# Leave empty to expose all GPUs. Set to "0,1" if the host has more than two GPUs.
GPU_DEVICES=

# Set to 1 to list available model profiles and exit.
LIST_PROFILES=0

# Set to 1 when intentionally replacing an existing container with the same name.
RECREATE=0
