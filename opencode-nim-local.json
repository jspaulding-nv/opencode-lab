{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "nim-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NVIDIA NIM Local",
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1",
        "apiKey": "not-needed",
        "timeout": false,
        "chunkTimeout": 120000
      },
      "models": {
        "nvidia/nemotron-3-super-120b-a12b": {
          "name": "Nemotron 3 Super 120B A12B (local NIM)",
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    }
  },
  "model": "nim-local/nvidia/nemotron-3-super-120b-a12b",
  "small_model": "nim-local/nvidia/nemotron-3-super-120b-a12b",
  "agent": {
    "build": {
      "model": "nim-local/nvidia/nemotron-3-super-120b-a12b",
      "temperature": 1.0,
      "top_p": 0.95
    },
    "plan": {
      "model": "nim-local/nvidia/nemotron-3-super-120b-a12b",
      "temperature": 1.0,
      "top_p": 0.95
    }
  }
}
